# FindNeo backend — environment reference.
#
# This file is committed and contains NO real values. Generate a working .env
# with `pnpm db:setup`, which creates the databases and roles and fills in the
# generated secrets. Every variable below is required unless marked otherwise;
# nothing has a default, and the process fails fast at startup on anything
# missing or malformed (SEC-060, ER-046).

# development | test | staging | production
NODE_ENV=development
# fatal | error | warn | info | debug
LOG_LEVEL=debug

# Public listener — serves /v1/* and /bff/web/*
API_HOST=127.0.0.1
API_PORT=3000

# Operational listener — /health/* and /metrics only. Must be a loopback
# address: these endpoints are never publicly reachable (SEC-021, 12 §3).
# Must not equal API_PORT.
OPS_HOST=127.0.0.1
OPS_PORT=9464

# Connection URL for the application role (findneo_app). No default.
# Rejected if the database name ends in "_test".
# Never read when NODE_ENV=test.
DATABASE_URL=postgres://findneo_app:PASSWORD@localhost:5432/findneo_dev
DATABASE_POOL_MAX=10

# Optional. When NODE_ENV=test: if set, tests run against this database;
# if unset, the Testcontainers harness starts a container and sets it.
# Either way the database name MUST end in "_test" or the run is refused
# before any DDL executes.
# DATABASE_URL_TEST=postgres://findneo_app:PASSWORD@localhost:5432/findneo_test

# Owner connection to the test database. Database tests need two roles: the
# app role, which owns nothing so FORCE ROW LEVEL SECURITY genuinely applies to
# it, and an owner role to create fixtures and to prove the rows exist — a
# zero-row result from an empty table proves nothing. Test-only; both URLs are
# checked against the _test suffix before any DDL runs.
# DATABASE_URL_TEST_OWNER=postgres://findneo_migrator:PASSWORD@localhost:5432/findneo_test

# Migration tooling only (drizzle-kit). Deliberately NOT part of the validated
# application config — the API and worker must never hold owner credentials.
DATABASE_URL_MIGRATOR=postgres://findneo_migrator:PASSWORD@localhost:5432/findneo_dev

# filesystem | s3. Phase 0 implements filesystem only; the S3 adapter arrives
# in Phase 3 and must pass the same port conformance suite unchanged.
STORAGE_DRIVER=filesystem
# Required when STORAGE_DRIVER=filesystem. Absolute path.
STORAGE_FS_ROOT=/absolute/path/to/var/storage

# log | smtp. `log` writes the message to the logger instead of sending.
MAIL_DRIVER=log

# Base64-encoded PEM (Ed25519 PKCS#8 / SPKI). Generated per install, never
# shared between installations (SEC-073). Multi-line PEM does not survive
# .env transport, hence base64.
JWT_PRIVATE_KEY=BASE64_PEM
JWT_PUBLIC_KEY=BASE64_PEM
# Minimum 32 characters.
COOKIE_SECRET=GENERATED_SECRET

# Must be false when NODE_ENV=production (07 §7, 12 §10).
SWAGGER_ENABLED=true

# Telemetry is off by default and never egresses by default (SEC-070).
OTEL_ENABLED=false
# Required when OTEL_ENABLED=true.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
