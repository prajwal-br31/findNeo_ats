{
  "name": "findneo-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts --test",
    "verify:boundaries": "tsx scripts/verify-boundaries.ts",
    "verify:semgrep": "tsx scripts/verify-semgrep.ts",
    "db:setup": "tsx scripts/setup-dev-db.ts",
    "config:check": "node --env-file-if-exists=.env --import tsx src/platform/config/config.cli.ts",
    "prepare": "husky",
    "test:isolation": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run src/platform/db/__tests__/tenant-context.test.ts src/platform/db/__tests__/role-privileges.test.ts src/testing/harness/__tests__/test-database.test.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@fastify/under-pressure": "9.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "lru-cache": "11.5.2",
    "pg": "8.23.0",
    "pg-boss": "10.4.2",
    "pino": "9.14.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-boundaries": "7.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
