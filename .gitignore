# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Environment — never committed (ER-046, SEC-060)
.env
.env.*
!.env.example

# Local runtime state: the filesystem StoragePort root (D-004) and anything
# else a process writes beside the code. Ignored wholesale rather than
# per-subdirectory, so a new writer cannot land uploaded files in a commit.
var/

# Test and coverage output
coverage/
*.log

# Local curl request bodies. Named individually rather than as `*.json` —
# package.json, tsconfig.json and drizzle/meta are all tracked, and a blanket
# rule would silently stop `git add .` from seeing changes to any of them.
body.json
empty.json
login.json
signup.json
verify.json
mfa.json
job.json

# Key material. Nothing should ever produce these here — JWT keys travel
# base64-encoded inside .env (ER-046) — which is exactly why an accidental one
# must not be reachable by `git add .`.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.semgrep-venv/

# Local agent/session settings
.claude/settings.local.json
